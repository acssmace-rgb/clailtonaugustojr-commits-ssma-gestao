# ---------------------------------------------------------------
# SSMA Gestão — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o arquivo .env. Em produção use um serviço de
# segredos (AWS Secrets Manager, GCP Secret Manager, Vault...).
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Origem pública da aplicação web (usada em CORS, CSRF e links de e-mail)
APP_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://ssma:ssma_dev@localhost:5432/ssma?schema=public

# Chave de 32 bytes em base64 para criptografia de campos sensíveis (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Sessão
SESSION_TTL_HOURS=12
# Tentativas de login por IP a cada 15 minutos
LOGIN_RATE_LIMIT=10

# Armazenamento de arquivos: "local" (pasta) ou "s3" (S3 ou compatível)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# E-mail (opcional). Sem SMTP, notificações ficam apenas no sistema.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SSMA Gestão <nao-responda@exemplo.com.br>"

# eSocial — transmissão oficial DESABILITADA até haver certificado,
# procuração e homologação. Ver docs/ESOCIAL.md.
ESOCIAL_TRANSMITTER=disabled
ESOCIAL_AMBIENTE=producao_restrita
ESOCIAL_CERT_PATH=
ESOCIAL_CERT_PASSWORD=

# Permite rodar o seed de demonstração (sempre false em produção)
ALLOW_DEMO_SEED=true
